# LOCAL DEV stack. Copy to .env.local (git-ignored) and fill in. Used by docker-compose.local.yml.
# Nothing here is a real secret: it is a throwaway stack on this PC with its own Discord application.

COMPOSE_PROJECT_NAME=calcrony-dev

# Fine as-is for a local-only stack.
CALCRONY_API_KEY=dev-api-key-change-me
CALCRONY_JWT_SIGNING_KEY=dev-signing-key-change-me-32chars!
CALCRONY_PUBLIC_BASE_URL=http://localhost:8080
CALCRONY_WEB_ORIGIN=http://localhost:8082

# Game Nights extension (API and bot). On locally; staging and prod keep it off until promoted.
GAMENIGHTS_ENABLED=true
# Comma-separated server ids to load the standard games into at startup (idempotent). Optional.
GAMENIGHTS_SEED_GUILD_IDS=

# --- Discord: the DEV application and DEV server, NOT the staging or prod ones ---
# One bot token must only ever run in one place: two running copies both answer every command.
# Developer Portal -> OAuth2 -> Redirects: add http://localhost:8080/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_TEST_GUILD_ID=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
