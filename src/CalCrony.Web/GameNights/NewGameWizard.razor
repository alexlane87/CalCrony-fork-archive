@* The "add a game" wizard, four steps like the Discord one: the basics, how a result is recorded, the starting
   questions, and the role. The role step is where things go wrong in Discord, so it says up front what the bot
   needs; if the bot later cannot make or give the role, the game shows the reason. The definition is built and
   checked with the same shared rules the API uses, so mistakes show here before anything is sent. *@
@using CalCrony.Contracts.GameNights
@inject GameNightsWebApiClient GameNights

<div class="card p-3 mt-3" style="max-width:640px" data-testid="wizard">
    <h2 class="h6 mb-1">Add a game</h2>
    <div class="meta-mono mb-2">Step @step of 4</div>

    @if (error is not null)
    {
        <div class="alert alert-danger py-2">@error</div>
    }

    @if (step == 1)
    {
        <div class="row g-2">
            <div class="col-12">
                <label class="form-label meta-mono mb-1" for="wizName">Name</label>
                <input id="wizName" class="form-control form-control-sm" maxlength="@GameRules.NameLength" placeholder="e.g. Root" @bind="name" @bind:event="oninput" />
            </div>
            <div class="col-4">
                <label class="form-label meta-mono mb-1" for="wizMin">Fewest players</label>
                <input id="wizMin" class="form-control form-control-sm" type="number" min="@GameRules.AbsoluteMinSize" max="@GameRules.AbsoluteMaxSize" @bind="min" />
            </div>
            <div class="col-4">
                <label class="form-label meta-mono mb-1" for="wizMax">Most players</label>
                <input id="wizMax" class="form-control form-control-sm" type="number" min="@GameRules.AbsoluteMinSize" max="@GameRules.AbsoluteMaxSize" @bind="max" />
            </div>
            <div class="col-4">
                <label class="form-label meta-mono mb-1" for="wizUsual">Usual table</label>
                <input id="wizUsual" class="form-control form-control-sm" type="number" min="@GameRules.AbsoluteMinSize" max="@GameRules.AbsoluteMaxSize" @bind="usual" />
            </div>
        </div>
    }
    else if (step == 2)
    {
        <label class="form-label meta-mono mb-1" for="wizType">How is a result recorded?</label>
        <select id="wizType" class="form-select form-select-sm" @bind="resultType">
            <option value="@GameResultType.RankedPlacement">Finishing places (ties allowed)</option>
            <option value="@GameResultType.SingleWinner">A single winner</option>
            <option value="@GameResultType.WinningSide">A winning side</option>
        </select>
    }
    else if (step == 3)
    {
        <label class="form-label meta-mono mb-1" for="wizTemplate">What should a result report ask?</label>
        <select id="wizTemplate" class="form-select form-select-sm" @bind="template">
            <option value="@GameWizard.FieldTemplate.PlayersAndScores">Players and final scores</option>
            <option value="@GameWizard.FieldTemplate.PlayersOnly">Players only</option>
        </select>
        <div class="form-text">You can add more questions to a game later.</div>
    }
    else
    {
        <p class="mb-2">Members follow a game by taking its Discord role, so people can find players when a table forms.</p>
        <div class="alert alert-info py-2" data-testid="role-guidance">
            <strong>What the bot needs.</strong> To <em>create</em> a role the bot needs the <strong>Manage Roles</strong> permission.
            To <em>give</em> a role (new or existing) the bot's own role must sit <strong>above</strong> it in
            Server Settings → Roles. If something is missing, the game will show exactly what once the bot has tried.
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" id="roleCreate" name="roleMode" checked="@(roleMode == RoleMode.Create)" @onchange="() => roleMode = RoleMode.Create" />
            <label class="form-check-label" for="roleCreate">Create a new role called “@name”</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" id="roleAttach" name="roleMode" checked="@(roleMode == RoleMode.Attach)" @onchange="() => roleMode = RoleMode.Attach" />
            <label class="form-check-label" for="roleAttach">Use an existing role</label>
        </div>
        @if (roleMode == RoleMode.Attach)
        {
            <div class="ms-4 mb-2">
                <input id="wizRoleId" class="form-control form-control-sm" style="max-width:20rem" placeholder="Role ID" @bind="roleIdText" @bind:event="oninput" />
                <div class="form-text">In Discord: turn on Developer Mode, then right-click the role in Server Settings → Roles → Copy Role ID.</div>
            </div>
        }
        <div class="form-check">
            <input class="form-check-input" type="radio" id="roleNone" name="roleMode" checked="@(roleMode == RoleMode.None)" @onchange="() => roleMode = RoleMode.None" />
            <label class="form-check-label" for="roleNone">No role</label>
        </div>
    }

    <div class="d-flex gap-2 mt-3">
        @if (step > 1)
        {
            <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="Back">Back</button>
        }
        @if (step < 4)
        {
            <button class="btn btn-primary btn-sm" disabled="@busy" @onclick="Next">Next</button>
        }
        else
        {
            <button class="btn btn-primary btn-sm" disabled="@busy" @onclick="SaveAsync">Add game</button>
        }
        <button class="btn btn-link btn-sm" @onclick="OnCancel">Cancel</button>
    </div>
</div>

@code {
    private enum RoleMode { Create, Attach, None }

    [Parameter, EditorRequired] public long GuildId { get; set; }

    /// <summary>The keys already used on the server (including retired games), so the new key is unique.</summary>
    [Parameter] public IReadOnlyList<string> TakenKeys { get; set; } = [];

    /// <summary>Raised with the created game.</summary>
    [Parameter] public EventCallback<GameDto> OnCreated { get; set; }

    /// <summary>Raised when the organiser gives up.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private int step = 1;
    private bool busy;
    private string? error;
    private string name = "";
    private int min = 2;
    private int max = 4;
    private int usual = 4;
    private GameResultType resultType = GameResultType.RankedPlacement;
    private GameWizard.FieldTemplate template = GameWizard.FieldTemplate.PlayersAndScores;
    private RoleMode roleMode = RoleMode.Create;
    private string roleIdText = "";

    private void Back()
    {
        error = null;
        step--;
    }

    private void Next()
    {
        error = null;
        if (step == 1 && GameRules.Validate(Build(null)) is { Count: > 0 } problems)
        {
            // Only the basics are asked so far; ignore complaints about things chosen later (there are none yet).
            error = string.Join(" ", problems);
            return;
        }

        step++;
    }

    private GameSpec Build(long? roleId) =>
        GameWizard.Build(name, resultType, min, max, usual, template, roleId, TakenKeys);

    private async Task SaveAsync()
    {
        error = null;
        long? roleId = null;
        if (roleMode == RoleMode.Attach)
        {
            if (!long.TryParse(roleIdText.Trim(), out var parsed) || parsed <= 0)
            {
                error = "Paste the role's ID: a long number copied from Discord.";
                return;
            }

            roleId = parsed;
        }

        var spec = Build(roleId);
        if (GameRules.Validate(spec) is { Count: > 0 } problems)
        {
            error = string.Join(" ", problems);
            return;
        }

        busy = true;
        try
        {
            var created = await GameNights.CreateGameAsync(GuildId, spec);
            if (!created.Success)
            {
                error = created.Error;
                return;
            }

            var game = created.Value!;
            if (roleMode == RoleMode.Create)
            {
                // The bot makes the role in the background; the game shows "creating" and then the outcome.
                game = (await GameNights.RequestRoleAsync(GuildId, game.Id)).Value ?? game;
            }

            await OnCreated.InvokeAsync(game);
        }
        finally
        {
            busy = false;
        }
    }
}
